<?xml version="1.0" encoding="UTF-8"?>
<!--
    Padrão de log estruturado do projeto: action=verb_noun status=ok|error id={valor} campo={valor}
    O placeholder %X{traceId} injeta o trace-id colocado no MDC pelo TraceIdFilter (com.base.config),
    permitindo correlacionar todas as linhas de log de uma mesma requisição HTTP.
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [traceId=%X{traceId:-}] [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
